{
  "apiVersion": "audit.k8s.io/v1",
  "kind": "Policy",
  "omitStages": [
    "RequestReceived"
  ],
  "rules": [
    {
      "level": "RequestResponse",
      "namespaces": [
        "study-consistency"
      ],
      "verbs": [
        "create",
        "update",
        "patch"
      ],
      "resources": [
        {
          "group": "",
          "resources": [
            "pods",
            "pods/ephemeralcontainers"
          ]
        }
      ]
    },
    {
      "level": "None"
    }
  ]
}
