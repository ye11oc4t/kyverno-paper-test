{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "v2-ephemeral-image-first",
    "namespace": "study-consistency",
    "resourceVersion": "735"
  },
  "spec": {
    "ephemeralContainers": [
      {
        "name": "study-a",
        "image": "study.local/alternate/pause:3.10",
        "imagePullPolicy": "Never",
        "securityContext": {
          "runAsNonRoot": true,
          "runAsUser": 1000,
          "runAsGroup": 1000,
          "allowPrivilegeEscalation": false,
          "readOnlyRootFilesystem": true,
          "capabilities": {
            "drop": [
              "ALL"
            ]
          },
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        }
      },
      {
        "name": "study-b",
        "image": "study.local/approved/pause:3.10",
        "imagePullPolicy": "Never",
        "securityContext": {
          "runAsNonRoot": true,
          "runAsUser": 1000,
          "runAsGroup": 1000,
          "allowPrivilegeEscalation": false,
          "readOnlyRootFilesystem": true,
          "capabilities": {
            "drop": [
              "ALL"
            ]
          },
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        }
      }
    ]
  }
}
