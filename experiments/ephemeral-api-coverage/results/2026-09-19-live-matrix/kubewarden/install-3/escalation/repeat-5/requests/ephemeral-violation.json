{
  "spec": {
    "ephemeralContainers": [
      {
        "name": "debug-violation",
        "image": "busybox:1.36.1",
        "imagePullPolicy": "IfNotPresent",
        "command": [
          "sh",
          "-c",
          "echo EPHEMERAL_VIOLATION_ESCALATION; id; grep -E \"^(CapEff|NoNewPrivs):\" /proc/self/status; sleep 120"
        ],
        "securityContext": {
          "privileged": false,
          "allowPrivilegeEscalation": true,
          "runAsNonRoot": true,
          "runAsUser": 65532,
          "capabilities": {
            "drop": [
              "ALL"
            ]
          },
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        }
      }
    ]
  }
}
