{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "ordinary-violation",
    "namespace": "live-ky-1-pri-3"
  },
  "spec": {
    "automountServiceAccountToken": false,
    "restartPolicy": "Never",
    "containers": [
      {
        "name": "main-violation",
        "image": "busybox:1.36.1",
        "imagePullPolicy": "IfNotPresent",
        "command": [
          "sh",
          "-c",
          "echo ORDINARY_VIOLATION_PRIVILEGED; id; grep -E \"^(CapEff|NoNewPrivs):\" /proc/self/status; sleep 120"
        ],
        "securityContext": {
          "privileged": true
        }
      }
    ]
  }
}
